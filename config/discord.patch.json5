{
  channels: {
    // "mentions" is the safe half of allowBots: a bot only accepts another
    // bot's message when that message mentions it. Cross-review works; idle
    // chatter between bots never starts.
    discord: {
      allowBots: "mentions",
      // Keep channel context tight. Long Discord history made research-channel
      // sessions carry tens of thousands of cached tokens and diluted answers
      // with old bot chatter. Eight recent messages is enough for "see above"
      // handoffs without dragging an entire mixed-topic channel into every turn.
      historyLimit: 8,
      contextVisibility: "all",
    },
    // Written out explicitly rather than left implicit, because these are the
    // numbers that stop a two-bot ping-pong from burning the whole quota.
    defaults: {
      botLoopProtection: {
        enabled: true,
        maxEventsPerWindow: 20,
        windowSeconds: 60,
        cooldownSeconds: 60,
      },
    },
  },
}
