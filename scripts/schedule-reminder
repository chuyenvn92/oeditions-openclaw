#!/usr/bin/env bash
# Fixed entrypoint for schedule-reminder.py — allows Xu to set reminders.
#
#   scripts/schedule-reminder "+30m" "<reminder text>"
#   scripts/schedule-reminder list
#   scripts/schedule-reminder cancel <id>
set -euo pipefail
DIR="$(cd "$(dirname "$0")/.." && pwd)"
. "$DIR/scripts/env.sh"
load_standard_env "$DIR"

PYTHON_BIN="$(command -v python3 || true)"
[ -n "$PYTHON_BIN" ] || { echo "python3 not found" >&2; exit 1; }

exec "$PYTHON_BIN" "$DIR/scripts/schedule-reminder.py" "$@"
