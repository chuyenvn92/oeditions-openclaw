#!/usr/bin/env bash
# Fixed entrypoint for ask-agent.py — allows Xu to consult other agents
# (Thợ, Chùa, Vé Tháng) directly.
#
#   scripts/ask-agent <agent_name> "<prompt>"
set -euo pipefail
DIR="$(cd "$(dirname "$0")/.." && pwd)"
. "$DIR/scripts/env.sh"
load_standard_env "$DIR"

# Ensure node/openclaw paths are on PATH
for nvm_bin in "$HOME"/.nvm/versions/node/*/bin /opt/homebrew/bin /usr/local/bin; do
  [ -d "$nvm_bin" ] && PATH="$nvm_bin:$PATH"
done
export PATH

PYTHON_BIN="$(command -v python3 || true)"
[ -n "$PYTHON_BIN" ] || { echo "python3 not found" >&2; exit 1; }

exec "$PYTHON_BIN" "$DIR/scripts/ask-agent.py" "$@"
